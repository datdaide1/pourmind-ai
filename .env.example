# LLM provider
OPENROUTER_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=
GEMINI_API_KEYS=

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:password@host:5432/database

# Redis
REDIS_HOST=
POSTGRES_SSL=true
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant (use http://localhost:6333 for a local instance)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional evaluation and deployment integrations
BRAINTRUST_API_KEY=

# Stable secret used to sign session capability tokens (minimum 32 random bytes in production)
SESSION_TOKEN_SECRET=

# Comma-separated exact origins; never use * with credentials in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_CHAT_MESSAGE_CHARS=4000
MAX_CHAT_HISTORY_MESSAGES=20
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MAX_CONCURRENCY=2
SEARCH_MAX_LIMIT=20
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=16384
